# Dominio .myshopify.com de la tienda (sin https://)
SHOPIFY_STORE_DOMAIN=nidohogar-peru.myshopify.com

# Access token de la Custom App creada en Shopify Admin (scopes: write_draft_orders,
# write_orders, read_orders, read_draft_orders). NUNCA lo pongas en código del tema.
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Origen permitido para CORS (el dominio público de tu tienda, con https://)
ALLOWED_ORIGIN=https://nidohogar-peru.myshopify.com

# Datos del flujo "Contra Entrega con Reserva" (opcionales, ya tienen default en el código)
MONTO_ADELANTO=10
YAPE_NUMERO=955083551
YAPE_TITULAR=Jesus Soler Huanca De La Cruz
