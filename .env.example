# Dominio .myshopify.com de la tienda (sin https://)
SHOPIFY_STORE_DOMAIN=nidohogar-peru.myshopify.com

# Access token de la Custom App creada en Shopify Admin (scopes: write_draft_orders,
# read_draft_orders, write_orders, read_orders). NO uses una app del Dev Dashboard
# con "client credentials grant" — ese flujo solo funciona con tiendas de desarrollo
# dentro de tu misma organización de Partners, no con una tienda real.
# NUNCA lo pongas en código del tema.
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Origen permitido para CORS (el dominio público de tu tienda, con https://)
ALLOWED_ORIGIN=https://nidohogar-peru.myshopify.com

# Secreto compartido que el tema debe enviar en el header "X-Checkout-Token"
# en cada request. Si se deja vacío, el endpoint acepta requests sin ese
# header (modo retrocompatible) — pero cualquiera con la URL puede entonces
# crear órdenes reales llamando directo, sin pasar por tu tema. Genera un
# valor largo y aleatorio y configúralo también en la sección del tema.
CHECKOUT_SHARED_SECRET=

# Monto de adelanto (opcional, default 10 en el código)
MONTO_ADELANTO=10

# Datos de Yape mostrados en la orden (obligatorios, sin default en el código
# por ser datos personales — no los dejes vacíos, y no hardcodees los reales
# aquí si este archivo se sube a un repo público; usa valores de ejemplo)
YAPE_NUMERO=999999999
YAPE_TITULAR=Nombre Apellido
