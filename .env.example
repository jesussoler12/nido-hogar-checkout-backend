# Dominio .myshopify.com de la tienda (sin https://)
SHOPIFY_STORE_DOMAIN=nidohogar-peru.myshopify.com

# Credenciales de la app creada en el Dev Dashboard de Shopify (dev.shopify.com),
# NO el token de una Custom App del Admin. El backend las usa para pedir un
# Admin API token vía OAuth "client credentials grant" (ver getAccessToken en
# api/crear-pedido.js). Cópialas desde dev.shopify.com → tu app → Configuración
# de la app → Credenciales de cliente. El Client Secret empieza con "shpss_".
# NUNCA las pongas en código del tema.
SHOPIFY_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_APP_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Origen permitido para CORS (el dominio público de tu tienda, con https://)
ALLOWED_ORIGIN=https://nidohogar-peru.myshopify.com

# Datos del flujo "Contra Entrega con Reserva" (opcionales, ya tienen default en el código)
MONTO_ADELANTO=10
YAPE_NUMERO=955083551
YAPE_TITULAR=Jesus Soler Huanca De La Cruz
